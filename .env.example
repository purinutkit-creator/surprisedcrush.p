PORT=3000
DATABASE_URL=postgres://gift:gift@localhost:5432/gift
DATABASE_SSL=false
# Only used the first time the database is created. Change the password from the admin afterwards.
ADMIN_INITIAL_PASSWORD=05/05/2011
# Behind a proxy (Render/Fly/Nginx) keep 1 so rate limits see the real client IP.
TRUST_PROXY=1
# Optional S3-compatible cloud storage. Leave empty to store files in PostgreSQL.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
